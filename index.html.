<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>APEXEDGE FUNDING | Prop Trading</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#080e19;color:white}
:root{--green:#b7f36b;--panel:#111d30;--muted:#aab6c8}
header{background:#0c1525;padding:20px;border-bottom:1px solid #26344a}
nav{max-width:1150px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:15px}
.logo{font-size:22px;font-weight:bold;color:var(--green)}
button,.btn{background:var(--green);color:#10170b;border:0;padding:13px 19px;border-radius:8px;font-weight:bold;cursor:pointer}
button:hover,.btn:hover{opacity:.85}
a{color:inherit;text-decoration:none}
.container{max-width:1150px;margin:auto;padding:25px}
.hero{padding:90px 20px;text-align:center;background:radial-gradient(circle at top,#203b4c,#080e19 65%)}
.hero h1{font-size:55px;margin-bottom:20px}
.hero h1 span{color:var(--green)}
.hero p{color:var(--muted);max-width:650px;margin:15px auto 25px;line-height:1.8}
section{padding:60px 20px}
h2{text-align:center;font-size:35px;margin-bottom:30px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px;max-width:1100px;margin:auto}
.card,.box{background:var(--panel);padding:25px;border-radius:13px;border:1px solid #26344a}
.card h3{margin:15px 0}
.price{font-size:32px;color:var(--green);font-weight:bold;margin:15px 0}
.card p,.box p{color:var(--muted);line-height:1.8}
.card ul{padding:15px 20px;color:#d6deeb;line-height:2}
.card button{width:100%;margin-top:15px}
.dashboard{display:none;min-height:100vh;background:#080e19}
.dashboard.active{display:block}
.dashhead{padding:25px;background:#101b2d;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px}
.dashbody{display:grid;grid-template-columns:220px 1fr;gap:20px;max-width:1250px;margin:auto;padding:20px}
.sidebar,.content{background:var(--panel);border-radius:12px;padding:20px}
.sidebar button{display:block;width:100%;margin:7px 0;text-align:left;background:transparent;color:white;border:1px solid #26344a}
.sidebar button.active{background:var(--green);color:#10170b}
.tab{display:none}
.tab.active{display:block}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:15px;margin-bottom:20px}
.stat{background:#1a2940;padding:20px;border-radius:10px}
.stat small{color:var(--muted)}
.stat h2{font-size:25px;color:var(--green);margin:10px 0;text-align:left}
table{width:100%;border-collapse:collapse;margin-top:15px;min-width:500px}
th,td{padding:13px;text-align:left;border-bottom:1px solid #304057;font-size:13px}
th{color:var(--green)}
.tablewrap{overflow-x:auto}
input,select{width:100%;padding:13px;margin:8px 0 15px;background:#091321;border:1px solid #34445d;border-radius:7px;color:white}
label{color:var(--muted);font-size:13px}
.form{max-width:500px}
.login{max-width:430px;margin:60px auto;padding:30px;background:var(--panel);border-radius:13px}
.notice{background:#292719;border:1px solid #76643a;padding:15px;margin:20px;border-radius:8px;color:#f4d99b;font-size:12px;line-height:1.6}
footer{text-align:center;padding:30px;color:var(--muted);border-top:1px solid #26344a}
@media(max-width:700px){
.hero h1{font-size:38px}
.dashbody{grid-template-columns:1fr}
.sidebar{display:flex;overflow-x:auto;gap:5px}
.sidebar button{min-width:max-content;width:auto}
}
</style>
</head>

